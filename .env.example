# AQIQAT AI баптаулары. Бұл файлды .env деп көшіріп, мәндерді толтырыңыз.
# SECRET_KEY бос болса, instance/secret_key файлында автоматты жасалады.
SECRET_KEY=
# AI провайдері: auto | anthropic | ollama | none
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Жергілікті тексеруге арналған демо аккаунт (сайтта тіркелген): логин demo, құпиясөз Demo2026aq
