# AQIQAT AI баптаулары. Бұл файлды .env деп көшіріп, мәндерді толтырыңыз.
# SECRET_KEY бос болса, instance/secret_key файлында автоматты жасалады.
SECRET_KEY=
# AI провайдері: auto | anthropic | gemini | groq | ollama | none
AI_PROVIDER=auto
# Тегін: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Тегін: https://console.groq.com/keys
GROQ_API_KEY=
# Кілтсіз де жұмыс істейді (30 секундта 1 жауап); тегін кілт шектеуді алады: https://enter.pollinations.ai
POLLINATIONS_API_KEY=
# Тұрақты дерекқор (Vercel → Storage → Neon қосылғанда өзі қойылады)
DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Жергілікті тексеруге арналған демо аккаунт (сайтта тіркелген): логин demo, құпиясөз Demo2026aq

# Telegram бот (токенді @BotFather береді). Webhook сайт ашылғанда өзі тіркеледі.
TELEGRAM_BOT_TOKEN=
